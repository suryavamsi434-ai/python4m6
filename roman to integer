class Solution(object):
    def romanToInt(self, s):
        """
        :type s: str
        :rtype: int
        """
        # Define the mapping of Roman numerals to their integer values
        roman_map = {
            'I': 1, 'V': 5, 'X': 10, 'L': 50,
            'C': 100, 'D': 500, 'M': 1000
        }
        
        total = 0
        i = 0
        n = len(s)
        
        # Iterate through the Roman numeral string
        while i < n:
            # Get the value of the current symbol
            current_value = roman_map[s[i]]
            
            # Check if there is a next symbol (lookahead)
            if i + 1 < n:
                next_value = roman_map[s[i+1]]
                
                # Check for the subtractive case (e.g., IV, IX, XL, etc.)
                # If the current value is less than the next value, 
                # it's a subtractive pair.
                if current_value < next_value:
                    # Add the difference (e.g., V - I = 4)
                    total += next_value - current_value
                    # Skip the next character as it was part of the pair
                    i += 2
                    continue
            
            # Add the value of the single symbol (additive case or last character)
            total += current_value
            # Move to the next character
            i += 1
            
        return total
