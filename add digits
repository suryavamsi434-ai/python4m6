class Solution:
    def addDigits(self, num: int) -> int:
        while num>=10:
            sumi=0
            while num>0:
                rem=num%10
                sumi+=rem
                num=num//10
            num=sumi
        return num

def majorityElements(nums):
    c1=0
    c2=0
    num1=num2=0
    for num in nums:
        if num==num1:
            c1+=1
        elif num==num2:
            c2+=1
        elif c1==0:
            num1=num
            c1=1
        elif c2==0:
            num2=num
            c2=1
        else:
            c1-=1
            c2-=1
