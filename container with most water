class Solution(object):
    def maxArea(self, height):
        """
        :type height: List[int]
        :rtype: int
        """
        # Initialize two pointers: one at the beginning and one at the end of the array
        left = 0
        right = len(height) - 1
        # Initialize the maximum area found so far to zero
        max_area = 0

        # Continue the loop as long as the left pointer is to the left of the right pointer
        while left < right:
            # 1. Calculate the current area
            # The height of the container is limited by the shorter line (min(height[left], height[right]))
            # The width is the distance between the two lines (right - left)
            current_height = min(height[left], height[right])
            width = right - left
            current_area = current_height * width
            
            # 2. Update the maximum area
            max_area = max(max_area, current_area)

            # 3. Move the pointer of the shorter line inward
            # Moving the shorter line has the potential to find a greater area 
            # (if the new line is taller), while moving the taller line guarantees
            # the height will either stay the same or decrease.
            if height[left] < height[right]:
                left += 1
            else:
                right -= 1
        
        # Return the maximum area found
        return max_area
